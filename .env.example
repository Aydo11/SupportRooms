# ---------- Core ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportrooms?schema=public"
# Must be at least 32 characters. Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32-characters-minimum"
APP_URL="http://localhost:3000"

# ---------- Storage (media uploads) ----------
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER="local"
# Private files (referral attachments, verification evidence) are written here,
# OUTSIDE the web root. Never point this inside ./public.
PRIVATE_UPLOAD_DIR=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------- Billing (provider-agnostic; Stripe adapter included) ----------
# BILLING_DRIVER=mock | stripe
BILLING_DRIVER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_FEATURED_LISTING=""

# ---------- Email / SMS (adapters stubbed in src/lib/notify.ts) ----------
# EMAIL_DRIVER=console | resend | ses
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"
# SMS_DRIVER=console | twilio
SMS_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---------- Maps / geocoding ----------
# The map works out of the box: OpenStreetMap tiles and postcodes.io geocoding,
# neither of which needs an account. Swap the tile URL for a paid provider when
# traffic justifies it.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
# GEOCODE_DRIVER=postcodes | none
GEOCODE_DRIVER="postcodes"

# ---------- Security ----------
# RATE_LIMIT_DRIVER=memory | redis
# memory works on a single instance; use redis behind a load balancer.
RATE_LIMIT_DRIVER="memory"
REDIS_URL=""
# Set to false if the app is exposed directly rather than behind a proxy you
# control, so a spoofed X-Forwarded-For can't be used to dodge rate limits.
TRUST_PROXY="true"
